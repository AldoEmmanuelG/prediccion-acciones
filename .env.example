# Copia este archivo como .env y ajusta los valores. NUNCA subas .env a Git.
# Este archivo solo documenta QUE variables existen, sin valores reales.

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Donde MLflow guarda los experimentos (carpeta local por defecto)
MLFLOW_TRACKING_URI=file:./mlruns

# Puerto en el que Streamlit sirve la app
APP_PORT=8501

# Hoy no hay API keys: yfinance no las necesita.
# Si mas adelante se agrega un servicio con llave, se documenta aqui, vacia:
# SERVICIO_API_KEY=
