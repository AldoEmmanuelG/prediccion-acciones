# --- Entornos y caches de Python ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- Secretos: NUNCA al repositorio (solo se versiona .env.example) ---
.env
.env.*
!.env.example

# --- Datos: los versiona DVC, no Git ---
# Se conserva solo el .gitkeep para que la carpeta exista.
data/*
!data/.gitkeep
# Los punteros de DVC (archivos .dvc) SI se versionan: son texto pequeno que
# apunta a los datos reales, que viven en el remote de DVC.
!data/*.dvc

# --- Modelos: SI van en Git ---
# Pesan menos de 100 MB y la imagen de Docker los necesita adentro, asi que
# `docker build` funciona despues de clonar, sin pasos extra. Los formatos
# genericos siguen ignorados; solo se permiten los dos que usa el proyecto.
*.pkl
*.pth
*.h5
*.joblib
*.pt
!models/*.joblib
!models/*.pt
# Checkpoint de exploracion del notebook 03: no es un entregable.
models/mlp_exploracion.pt

# --- Artefactos de MLflow y cobertura ---
mlruns/
mlartifacts/
mlflow.db
.coverage
htmlcov/

# --- Sistema operativo y editores ---
.DS_Store
Thumbs.db
.idea/
.vscode/
